{
  "name": "wpstudbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build && node scripts/check-single-file.mjs",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
